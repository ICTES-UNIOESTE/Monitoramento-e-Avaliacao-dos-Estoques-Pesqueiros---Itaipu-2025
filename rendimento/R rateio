# =========================
# 3) FUNÇÃO DE RATEIO
# =========================
fazer_rateio <- function(bio_df, rend_df, nome_saida = "saida") {
  
  # composição da biopesca - geral
  biopesca_comp_geral <- bio_df %>%
    transmute(
      Zona,
      Espécie_original = Espécie
    ) %>%
    left_join(mapa_estoque, by = "Espécie_original") %>%
    filter(!is.na(estoque)) %>%
    count(estoque, Espécie_original, name = "n_biopesca") %>%
    group_by(estoque) %>%
    mutate(
      total_biopesca_estoque = sum(n_biopesca, na.rm = TRUE),
      prop_biopesca = n_biopesca / total_biopesca_estoque,
      perc_biopesca = 100 * prop_biopesca
    ) %>%
    ungroup() %>%
    arrange(estoque, desc(prop_biopesca))
  
  # composição da biopesca - por zona
  biopesca_comp_zona <- bio_df %>%
    transmute(
      Zona,
      Espécie_original = Espécie
    ) %>%
    left_join(mapa_estoque, by = "Espécie_original") %>%
    filter(!is.na(estoque)) %>%
    count(Zona, estoque, Espécie_original, name = "n_biopesca") %>%
    group_by(Zona, estoque) %>%
    mutate(
      total_biopesca_estoque = sum(n_biopesca, na.rm = TRUE),
      prop_biopesca = n_biopesca / total_biopesca_estoque,
      perc_biopesca = 100 * prop_biopesca
    ) %>%
    ungroup() %>%
    arrange(Zona, estoque, desc(prop_biopesca))
  
  # rendimento - geral
  rendimento_geral <- rend_df %>%
    filter(
      !is.na(ESPÉCIES),
      !str_detect(ESPÉCIES, "TOTAL"),
      ESPÉCIES != "Outros"
    ) %>%
    group_by(estoque = ESPÉCIES) %>%
    summarise(
      kg_rendimento_total = sum(SEMANATOT, na.rm = TRUE),
      cpue_estoque_kg_pescador_dia = mean(CPUE.Espécie..kg.pescador.dia., na.rm = TRUE),
      sd_cpue_estoque = sd(CPUE.Espécie..kg.pescador.dia., na.rm = TRUE),
      n_registros_rendimento = n(),
      .groups = "drop"
    )
  
  # rendimento - por zona
  rendimento_zona <- rend_df %>%
    filter(
      !is.na(ESPÉCIES),
      !str_detect(ESPÉCIES, "TOTAL"),
      ESPÉCIES != "Outros"
    ) %>%
    group_by(Zona = ZONA, estoque = ESPÉCIES) %>%
    summarise(
      kg_rendimento_total = sum(SEMANATOT, na.rm = TRUE),
      cpue_estoque_kg_pescador_dia = mean(CPUE.Espécie..kg.pescador.dia., na.rm = TRUE),
      sd_cpue_estoque = sd(CPUE.Espécie..kg.pescador.dia., na.rm = TRUE),
      n_registros_rendimento = n(),
      .groups = "drop"
    )
  
  # rateio - geral
  tabela_rateio_geral <- biopesca_comp_geral %>%
    left_join(rendimento_geral, by = "estoque") %>%
    mutate(
      kg_rendimento_rateado = kg_rendimento_total * prop_biopesca,
      cpue_recalculada_kg_pescador_dia = cpue_estoque_kg_pescador_dia * prop_biopesca
    ) %>%
    rename(
      Estoque = estoque,
      Espécie = Espécie_original
    ) %>%
    select(
      Estoque,
      Espécie,
      n_biopesca,
      total_biopesca_estoque,
      prop_biopesca,
      perc_biopesca,
      kg_rendimento_total,
      kg_rendimento_rateado,
      cpue_estoque_kg_pescador_dia,
      cpue_recalculada_kg_pescador_dia,
      sd_cpue_estoque,
      n_registros_rendimento
    ) %>%
    arrange(Estoque, desc(prop_biopesca))
  
  # rateio - por zona
  tabela_rateio_zona <- biopesca_comp_zona %>%
    left_join(rendimento_zona, by = c("Zona", "estoque")) %>%
    mutate(
      kg_rendimento_rateado = kg_rendimento_total * prop_biopesca,
      cpue_recalculada_kg_pescador_dia = cpue_estoque_kg_pescador_dia * prop_biopesca
    ) %>%
    rename(
      Estoque = estoque,
      Espécie = Espécie_original
    ) %>%
    select(
      Zona,
      Estoque,
      Espécie,
      n_biopesca,
      total_biopesca_estoque,
      prop_biopesca,
      perc_biopesca,
      kg_rendimento_total,
      kg_rendimento_rateado,
      cpue_estoque_kg_pescador_dia,
      cpue_recalculada_kg_pescador_dia,
      sd_cpue_estoque,
      n_registros_rendimento
    ) %>%
    arrange(Zona, Estoque, desc(prop_biopesca))
  
  # conferência de match
  estoques_biopesca_geral <- biopesca_comp_geral %>% distinct(estoque)
  estoques_rendimento_geral <- rendimento_geral %>% distinct(estoque)
  
  sem_match_rend <- anti_join(
    estoques_biopesca_geral,
    estoques_rendimento_geral,
    by = "estoque"
  )
  
  sem_match_bio <- anti_join(
    estoques_rendimento_geral,
    estoques_biopesca_geral,
    by = "estoque"
  )
  
  write.xlsx(
    list(
      biopesca_geral   = biopesca_comp_geral,
      rendimento_geral = rendimento_geral,
      rateio_geral     = tabela_rateio_geral,
      biopesca_zona    = biopesca_comp_zona,
      rendimento_zona  = rendimento_zona,
      rateio_zona      = tabela_rateio_zona,
      sem_match_rend   = sem_match_rend,
      sem_match_bio    = sem_match_bio
    ),
    file = paste0("Rateio_", nome_saida, ".xlsx"),
    overwrite = TRUE
  )
  
  list(
    biopesca_comp_geral = biopesca_comp_geral,
    rendimento_geral = rendimento_geral,
    tabela_rateio_geral = tabela_rateio_geral,
    biopesca_comp_zona = biopesca_comp_zona,
    rendimento_zona = rendimento_zona,
    tabela_rateio_zona = tabela_rateio_zona
  )
}

