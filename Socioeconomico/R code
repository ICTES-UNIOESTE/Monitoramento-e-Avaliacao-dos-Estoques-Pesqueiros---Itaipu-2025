n_localidade <- function(df, localidade, include_geral = TRUE, distinct_nome = TRUE) {
  if (localidade == "Geral" && include_geral) {
    if (distinct_nome) return(dplyr::n_distinct(df$Nome.Completo))
    return(nrow(df))
  }
  
  df_loc <- df %>% filter(Zona.de.Pesca == localidade)
  
  if (distinct_nome) {
    dplyr::n_distinct(df_loc$Nome.Completo)
  } else {
    nrow(df_loc)
  }
}

n_valido_simples <- function(df, coluna, localidade, include_geral = TRUE, distinct_nome = TRUE) {
  if (localidade == "Geral" && include_geral) {
    base <- df
  } else {
    base <- df %>% filter(Zona.de.Pesca == localidade)
  }
  
  base <- base %>%
    filter(!is.na(.data[[coluna]]), .data[[coluna]] != "")
  
  if (distinct_nome) {
    dplyr::n_distinct(base$Nome.Completo)
  } else {
    nrow(base)
  }
}

n_valido_multiresposta <- function(df, coluna, localidade, include_geral = TRUE,
                                   excluir_padrao = NULL) {
  if (localidade == "Geral" && include_geral) {
    base <- df
  } else {
    base <- df %>% filter(Zona.de.Pesca == localidade)
  }
  
  base <- base %>%
    filter(!is.na(.data[[coluna]]), .data[[coluna]] != "")
  
  if (!is.null(excluir_padrao)) {
    base <- base %>%
      filter(!grepl(excluir_padrao, .data[[coluna]], ignore.case = TRUE))
  }
  
  base <- base %>%
    separate_rows(.data[[coluna]], sep = ",") %>%
    mutate(valor_limpo = str_trim(.data[[coluna]])) %>%
    filter(valor_limpo != "")
  
  nrow(base)
}

n_valido_classes <- function(df, coluna, localidade, include_geral = TRUE,
                             breaks, labels, distinct_nome = TRUE) {
  if (localidade == "Geral" && include_geral) {
    base <- df
  } else {
    base <- df %>% filter(Zona.de.Pesca == localidade)
  }
  
  base <- base %>%
    filter(!is.na(.data[[coluna]])) %>%
    mutate(classe = cut(.data[[coluna]], breaks = breaks, labels = labels, right = FALSE)) %>%
    filter(!is.na(classe))
  
  if (distinct_nome) {
    dplyr::n_distinct(base$Nome.Completo)
  } else {
    nrow(base)
  }
}

paleta_alfabetica <- function(categorias) {
  categorias <- sort(unique(as.character(categorias)))
  categorias <- categorias[!is.na(categorias)]
  
  if (length(categorias) == 0) return(NULL)
  
  cores <- paleta_categorica_10
  if (length(categorias) > length(cores)) {
    cores <- rep(cores, length.out = length(categorias))
  } else {
    cores <- cores[seq_along(categorias)]
  }
  
  stats::setNames(cores, categorias)
}

paleta_por_ordem <- function(ordem_categorias) {
  n_cat <- length(ordem_categorias)
  
  if (n_cat == 0) return(NULL)
  
  cores <- paleta_categorica_10
  if (n_cat > length(cores)) {
    cores <- rep(cores, length.out = n_cat)
  } else {
    cores <- cores[seq_len(n_cat)]
  }
  
  stats::setNames(cores, ordem_categorias)
}

