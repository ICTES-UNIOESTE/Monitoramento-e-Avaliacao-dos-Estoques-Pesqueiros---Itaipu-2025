    }
  }
  
  # 13 Metros quadrados de redes (boxplot)
  if (all(c("Parent.Row.ID", "Comprimento..m.", "Altura..m.", "Quantidade") %in% names(redes_raw))) {
    redes_m2 <- redes_raw %>%
      mutate(m2 = Comprimento..m. * Altura..m. * Quantidade)
    
    merged_m2 <- merge(
      redes_m2 %>% group_by(Parent.Row.ID) %>% summarise(m2 = sum(m2, na.rm = TRUE), .groups = "drop"),
      df_socio,
      by.x = "Parent.Row.ID",
      by.y = "Row.ID",
      all.y = TRUE
    ) %>%
      filter(!is.na(m2))
    
    if (nrow(merged_m2) > 0) {
      box_df <- if (include_geral) {
        bind_rows(
          merged_m2 %>% mutate(Localidade = as.character(Zona.de.Pesca)),
          merged_m2 %>% mutate(Localidade = "Geral")
        )
      } else {
        merged_m2 %>% mutate(Localidade = "Montante")
      }
      
      n_geral <- if (include_geral) dplyr::n_distinct(merged_m2$Nome.Completo) else NULL
      n_fluvial <- if (include_geral) dplyr::n_distinct(merged_m2 %>% filter(Zona.de.Pesca == "Fluvial") %>% pull(Nome.Completo)) else NULL
      n_transicao <- if (include_geral) dplyr::n_distinct(merged_m2 %>% filter(Zona.de.Pesca == "Transição") %>% pull(Nome.Completo)) else NULL
      n_lacustre <- if (include_geral) dplyr::n_distinct(merged_m2 %>% filter(Zona.de.Pesca == "Lacustre") %>% pull(Nome.Completo)) else NULL
      n_montante <- if (!include_geral) dplyr::n_distinct(merged_m2$Nome.Completo) else NULL
      
      if (include_geral) {
        painel <- criar_painel_2x2(
          fazer_plot_box_local(
            box_df %>% filter(Localidade == "Geral"),
            "m2", "Geral", "Geral",
            subtitulo_n(n_geral, "Número total de registros de pescadores"),
            ylab = "m²"
          ) + theme(legend.position = "none"),
          fazer_plot_box_local(
            box_df %>% filter(Localidade == "Fluvial"),
            "m2", "Fluvial", "Fluvial",
            subtitulo_n(n_fluvial, "Número total de registros de pescadores"),
            ylab = "m²"
          ) + theme(legend.position = "none"),
          fazer_plot_box_local(
            box_df %>% filter(Localidade == "Transição"),
            "m2", "Transição", "Transição",
            subtitulo_n(n_transicao, "Número total de registros de pescadores"),
            ylab = "m²"
          ) + theme(legend.position = "none"),
          fazer_plot_box_local(
            box_df %>% filter(Localidade == "Lacustre"),
            "m2", "Lacustre", "Lacustre",
            subtitulo_n(n_lacustre, "Número total de registros de pescadores"),
            ylab = "m²"
          ) + theme(legend.position = "none"),
          "Metros quadrados de redes",
          mostrar_legenda = FALSE
        )
        salvar_png(painel, "13_metros_quadrados_de_redes.png", 1000, 1000)
      } else {
        fig <- criar_figura_unica_montante(
          fazer_plot_box_local(
            box_df %>% filter(Localidade == "Montante"),
            "m2",
            "Montante",
            titulo_local = NULL,
            subtitulo_local = subtitulo_n(n_montante, "Número total de registros de pescadores"),
            mostrar_localidade = FALSE,
            ylab = "m²"
          ) +
            theme(
              legend.position = "none",
              axis.text.x = element_text(size = 20),
              axis.text.y = element_text(size = 20),
              axis.title.y = element_text(size = 22)
            ),
          "Metros quadrados de redes",
          mostrar_legenda = FALSE
        )
        salvar_png(fig, "13_metros_quadrados_de_redes.png", 1000, 1000)
      }
      
      resumo_m2 <- box_df %>%
        group_by(Localidade) %>%
        summarise(
          n = dplyr::n(),
          total_m2 = sum(m2, na.rm = TRUE),
          media_m2 = mean(m2, na.rm = TRUE),
          mediana_m2 = median(m2, na.rm = TRUE),
          q1_m2 = quantile(m2, 0.25, na.rm = TRUE),
          q3_m2 = quantile(m2, 0.75, na.rm = TRUE),
          minimo_m2 = min(m2, na.rm = TRUE),
          maximo_m2 = max(m2, na.rm = TRUE),
          .groups = "drop"
        )
      
      write.xlsx(resumo_m2, "13_tabela_metros_quadrados_de_redes.xlsx", rowNames = FALSE)
    }
  }
  
  # 14 Anzóis e redes em porcentagem
  if (all(c("Parent.Row.ID", "Malha") %in% names(redes_raw)) &&
      all(c("Parent.Row.ID", "Quantidade") %in% names(anzois_raw))) {
    
    merged_redes <- merge(redes_raw, df_socio, by.x = "Parent.Row.ID", by.y = "Row.ID", all.y = TRUE)
    merged_anzois <- merge(anzois_raw, df_socio, by.x = "Parent.Row.ID", by.y = "Row.ID", all.y = TRUE)
    
    redes_pres <- merged_redes %>%
      mutate(Redes = ifelse(!is.na(Malha), 1, 0)) %>%
      group_by(Nome.Completo, Zona.de.Pesca) %>%
      summarise(Redes = max(Redes, na.rm = TRUE), .groups = "drop")
    
    anzois_pres <- merged_anzois %>%
      mutate(Anzóis = ifelse(!is.na(Quantidade), 1, 0)) %>%
      group_by(Nome.Completo, Zona.de.Pesca) %>%
      summarise(Anzóis = max(Anzóis, na.rm = TRUE), .groups = "drop")
    
    apetrechos <- full_join(redes_pres, anzois_pres, by = c("Nome.Completo", "Zona.de.Pesca")) %>%
      mutate(
        Redes = ifelse(is.na(Redes), 0, Redes),
        Anzóis = ifelse(is.na(Anzóis), 0, Anzóis)
      )
    
    base_ap <- if (include_geral) {
      bind_rows(
        apetrechos %>% mutate(Localidade = as.character(Zona.de.Pesca)),
        apetrechos %>% mutate(Localidade = "Geral")
      )
    } else {
      apetrechos %>% mutate(Localidade = "Montante")
    }
    
    comp_redes <- base_ap %>%
      group_by(Localidade) %>%
      summarise(Presença_ratio = mean(Redes == 1), .groups = "drop") %>%
      mutate(Tipo = "Redes")
    
    comp_anzois <- base_ap %>%
      group_by(Localidade) %>%
      summarise(Presença_ratio = mean(Anzóis == 1), .groups = "drop") %>%
      mutate(Tipo = "Anzóis")
    
    tab_ap <- bind_rows(comp_redes, comp_anzois)
    
    tab_ap_excel <- tab_ap %>%
      mutate(
        Percentual = round(100 * Presença_ratio, 2)
      ) %>%
      select(Localidade, Tipo, Percentual, Presença_ratio)
    
    write.xlsx(tab_ap_excel, "14_tabela_anzois_e_redes.xlsx", rowNames = FALSE)
    
    n_geral <- if (include_geral) dplyr::n_distinct(apetrechos$Nome.Completo) else NULL
    n_fluvial <- if (include_geral) dplyr::n_distinct(apetrechos %>% filter(Zona.de.Pesca == "Fluvial") %>% pull(Nome.Completo)) else NULL
    n_transicao <- if (include_geral) dplyr::n_distinct(apetrechos %>% filter(Zona.de.Pesca == "Transição") %>% pull(Nome.Completo)) else NULL
    n_lacustre <- if (include_geral) dplyr::n_distinct(apetrechos %>% filter(Zona.de.Pesca == "Lacustre") %>% pull(Nome.Completo)) else NULL
    n_montante <- if (!include_geral) dplyr::n_distinct(apetrechos$Nome.Completo) else NULL
    
    if (include_geral) {
      painel_apetrecho_3zonas_n(
        tab_ap,
        titulo_painel = "Anzóis e redes em porcentagem",
        nome_arquivo = "14_anzois_e_redes_em_porcentagem.png",
        n_geral = n_geral,
        n_fluvial = n_fluvial,
        n_transicao = n_transicao,
        n_lacustre = n_lacustre,
        texto_n = "Número total de registros de pescadores"
      )
    } else {
      painel_apetrecho_montante_n(
        tab_ap,
        titulo_painel = "Anzóis e redes em porcentagem",
        nome_arquivo = "14_anzois_e_redes_em_porcentagem.png",
        n_montante = n_montante,
        texto_n = "Número total de registros de pescadores"
      )
    }
  }
  
  message("Bloco concluído: ", nome_bloco)
}

