fazer_plot_pizza <- function(tab_local, paleta, titulo_local = NULL,
                             subtitulo_local = NULL,
                             mostrar_localidade = TRUE,
                             nome_legenda = NULL) {
  
  if (nrow(tab_local) == 0) return(plot_vazio(titulo_local, subtitulo_local))
  
  categorias <- names(paleta)
  if (is.null(categorias) || any(is.na(categorias))) {
    categorias <- sort(unique(as.character(tab_local$categoria)))
    paleta <- paleta_alfabetica(categorias)
  }
  
  tab_local <- tab_local %>%
    mutate(categoria = factor(categoria, levels = names(paleta))) %>%
    tidyr::complete(categoria, fill = list(valor = 0))
  
  ggplot(tab_local, aes(x = "", y = valor, fill = categoria)) +
    geom_col(color = "black", linewidth = 0.05, width = 1) +
    coord_polar("y", start = 0) +
    scale_fill_manual(values = paleta, drop = FALSE, name = nome_legenda) +
    labs(
      title = localidade_titulo(titulo_local, mostrar_localidade),
      subtitle = subtitulo_local
    ) +
    tema_pizza
}

