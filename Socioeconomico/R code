painel_pizza_3zonas_n <- function(tab, titulo_painel, nome_arquivo, paleta, nome_legenda,
                                  n_geral, n_fluvial, n_transicao, n_lacustre,
                                  texto_n = "N") {
  
  ordem_geral <- tab %>%
    filter(Localidade == "Geral") %>%
    arrange(desc(valor), as.character(categoria)) %>%
    pull(categoria) %>%
    as.character()
  
  tab <- tab %>%
    mutate(categoria = factor(as.character(categoria), levels = ordem_geral))
  
  paleta <- paleta_por_ordem(ordem_geral)
  
  p_geral <- fazer_plot_pizza(
    tab %>% filter(Localidade == "Geral"),
