preparar_tab_simples <- function(df, coluna, include_geral = TRUE, distinct_nome = TRUE) {
  base <- df_com_localidade(df, include_geral = include_geral)
  
  base %>%
    filter(!is.na(.data[[coluna]]), .data[[coluna]] != "") %>%
    group_by(Localidade, categoria = .data[[coluna]]) %>%
    summarise(
      valor = if (distinct_nome) dplyr::n_distinct(Nome.Completo) else dplyr::n(),
      .groups = "drop"
    )
}

preparar_tab_multiresposta <- function(df, coluna, include_geral = TRUE,
                                       excluir_padrao = NULL,
                                       keep_top_n = NULL) {
  
  base <- df_com_localidade(df, include_geral = include_geral) %>%
    filter(!is.na(.data[[coluna]]), .data[[coluna]] != "")
  
  if (!is.null(excluir_padrao)) {
    base <- base %>%
      filter(!grepl(excluir_padrao, .data[[coluna]], ignore.case = TRUE))
  }
  
  base_sep <- base %>%
    separate_rows(.data[[coluna]], sep = ",") %>%
    mutate(categoria = str_trim(.data[[coluna]])) %>%
    filter(categoria != "")
  
  if (!is.null(keep_top_n)) {
    top_cat <- base_sep %>%
      filter(Localidade == ifelse(include_geral, "Geral", "Montante")) %>%
      count(categoria, sort = TRUE) %>%
      slice_head(n = keep_top_n) %>%
      pull(categoria)
    
    base_sep <- base_sep %>%
      mutate(categoria = ifelse(categoria %in% top_cat, categoria, "Outros"))
  }
  
  base_sep %>%
    group_by(Localidade, categoria) %>%
    summarise(valor = n(), .groups = "drop")
}

preparar_tab_classes <- function(df, coluna, breaks, labels, include_geral = TRUE,
                                 distinct_nome = TRUE) {
  base <- df_com_localidade(df, include_geral = include_geral) %>%
    filter(!is.na(.data[[coluna]])) %>%
    mutate(classe = cut(.data[[coluna]], breaks = breaks, labels = labels, right = FALSE)) %>%
    filter(!is.na(classe))
  
  base %>%
    group_by(Localidade, classe) %>%
    summarise(
      valor = if (distinct_nome) dplyr::n_distinct(Nome.Completo) else dplyr::n(),
      .groups = "drop"
    )
}

