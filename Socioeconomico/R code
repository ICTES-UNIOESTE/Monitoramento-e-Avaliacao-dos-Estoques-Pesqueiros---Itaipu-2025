  ggplot(df_local, aes(x = localidade, y = .data[[coluna_valor]], fill = localidade)) +
    geom_boxplot(color = "black", outlier.size = 1) +
    scale_fill_manual(values = cores_estrutura, drop = FALSE, name = "Localidade") +
    scale_y_continuous(
      breaks = breaks_y,
      labels = function(x) format(round(x, 0), trim = TRUE, scientific = FALSE)
