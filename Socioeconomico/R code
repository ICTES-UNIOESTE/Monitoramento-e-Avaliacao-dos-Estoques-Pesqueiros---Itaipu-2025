rodar_bloco <- function(df_socio, nome_bloco, pasta_saida,
                        include_geral = TRUE) {
  
  dir.create(pasta_saida, showWarnings = FALSE, recursive = TRUE)
  
  wd_original <- getwd()
  setwd(pasta_saida)
  on.exit(setwd(wd_original), add = TRUE)
  
  # 01 Pescadores por zonas
  if (include_geral) {
    tab_zona <- df_socio %>%
      group_by(Zona.de.Pesca) %>%
      summarise(n = dplyr::n_distinct(Nome.Completo), .groups = "drop")
    
    tab_zona_excel <- tab_zona %>%
      rename(Localidade = Zona.de.Pesca, Valor = n) %>%
      mutate(
        Total = sum(Valor, na.rm = TRUE),
        Percentual = round(100 * Valor / Total, 2)
      )
    
    write.xlsx(tab_zona_excel, "01_tabela_pescadores_por_zonas.xlsx", rowNames = FALSE)
    
    p_zona <- ggplot(tab_zona, aes(x = "", y = n, fill = Zona.de.Pesca)) +
      geom_col(color = "black", linewidth = 0.05, width = 1) +
      coord_polar("y", start = 0) +
      scale_fill_manual(
        values = cores_zona[names(cores_zona) %in% as.character(tab_zona$Zona.de.Pesca)],
        name = "Zona"
      ) +
      labs(
        title = NULL,
        subtitle = subtitulo_n(
          dplyr::n_distinct(df_socio$Nome.Completo),
          "Número total de registros de pescadores"
        )
      ) +
      theme_void() +
      theme(
        legend.position = "right",
        legend.justification = "bottom",
        legend.box.just = "right",
        legend.direction = "vertical",
        legend.text = element_text(size = 24),
        legend.title = element_text(size = 28, face = "bold"),
        plot.subtitle = element_text(size = 24, hjust = 0, margin = margin(t = 4, b = 6))
      )
    
    p_zona_final <- p_zona +
      plot_annotation(
        title = "Pescadores por zonas",
        theme = theme(
          plot.title = element_text(
            hjust = 0,
            size = 34,
            face = "bold"
          ),
          plot.margin = margin(10, 10, 10, 10)
        )
      ) &
      theme(
        legend.position = "right",
        legend.justification = "bottom",
        legend.box.just = "right",
        legend.direction = "vertical",
        plot.margin = margin(8, 8, 8, 8)
      )
    
    salvar_png(p_zona_final, "01_pescadores_por_zonas.png", 1000, 1000)
  }
  
  # 02 Sexo
  if ("Sexo" %in% names(df_socio)) {
    tab_sexo <- preparar_tab_simples(df_socio, "Sexo", include_geral = include_geral) %>%
      filter(categoria %in% c("Masculino", "Feminino"))
    
    salvar_tabela_percentual(
      tab_sexo,
      "02_tabela_sexo_dos_pescadores.xlsx",
      coluna_categoria = "categoria",
      coluna_valor = "valor",
      nome_categoria_saida = "Sexo"
    )
    
    n_geral <- if (include_geral) n_valido_simples(df_socio, "Sexo", "Geral", TRUE) else NULL
    n_fluvial <- if (include_geral) n_valido_simples(df_socio, "Sexo", "Fluvial", TRUE) else NULL
    n_transicao <- if (include_geral) n_valido_simples(df_socio, "Sexo", "Transição", TRUE) else NULL
    n_lacustre <- if (include_geral) n_valido_simples(df_socio, "Sexo", "Lacustre", TRUE) else NULL
    n_montante <- if (!include_geral) n_valido_simples(df_socio, "Sexo", "Montante", FALSE) else NULL
    
    if (include_geral) {
      painel_pizza_3zonas_n(
        tab_sexo,
        titulo_painel = "Sexo dos pescadores",
        nome_arquivo = "02_sexo_dos_pescadores.png",
        paleta = cores_sexo,
        nome_legenda = "Sexo",
        n_geral = n_geral,
        n_fluvial = n_fluvial,
        n_transicao = n_transicao,
        n_lacustre = n_lacustre,
        texto_n = "Número total de registros de pescadores"
      )
    } else {
      painel_pizza_montante_n(
        tab_sexo,
        titulo_painel = "Sexo dos pescadores",
        nome_arquivo = "02_sexo_dos_pescadores.png",
        paleta = cores_sexo,
        nome_legenda = "Sexo",
        n_montante = n_montante,
        texto_n = "Número total de registros de pescadores"
      )
    }
  }
  
  # 03 Presença de ajudantes
  col_aj <- "Trabalha.com.ajudante.de.pesca."
  if (col_aj %in% names(df_socio)) {
    tab_aj <- preparar_tab_simples(df_socio, col_aj, include_geral = include_geral) %>%
      filter(categoria %in% c("Sim", "Não", "Nao")) %>%
      mutate(categoria = ifelse(categoria == "Nao", "Não", as.character(categoria))) %>%
      group_by(Localidade, categoria) %>%
      summarise(valor = sum(valor), .groups = "drop")
    
    salvar_tabela_percentual(
      tab_aj,
      "03_tabela_presenca_de_ajudantes.xlsx",
      coluna_categoria = "categoria",
      coluna_valor = "valor",
      nome_categoria_saida = "Presenca_de_ajudantes"
    )
    
    n_geral <- if (include_geral) n_valido_simples(df_socio, col_aj, "Geral", TRUE) else NULL
    n_fluvial <- if (include_geral) n_valido_simples(df_socio, col_aj, "Fluvial", TRUE) else NULL
    n_transicao <- if (include_geral) n_valido_simples(df_socio, col_aj, "Transição", TRUE) else NULL
    n_lacustre <- if (include_geral) n_valido_simples(df_socio, col_aj, "Lacustre", TRUE) else NULL
    n_montante <- if (!include_geral) n_valido_simples(df_socio, col_aj, "Montante", FALSE) else NULL
    
    if (include_geral) {
      painel_pizza_3zonas_n(
        tab_aj,
        titulo_painel = "Presença de ajudantes",
        nome_arquivo = "03_presenca_de_ajudantes.png",
        paleta = cores_ajudantes_bin,
        nome_legenda = "Presença de ajudantes",
        n_geral = n_geral,
        n_fluvial = n_fluvial,
        n_transicao = n_transicao,
        n_lacustre = n_lacustre,
        texto_n = "Número total de registros de pescadores"
      )
    } else {
      painel_pizza_montante_n(
        tab_aj,
        titulo_painel = "Presença de ajudantes",
        nome_arquivo = "03_presenca_de_ajudantes.png",
        paleta = cores_ajudantes_bin,
        nome_legenda = "Presença de ajudantes",
        n_montante = n_montante,
        texto_n = "Número total de registros de pescadores"
      )
    }
  }
  
  # 04 Número de dependentes
  col_dep <- "Quantas.pessoas.dependem.da.sua.renda."
  if (col_dep %in% names(df_socio)) {
    base_dep <- df_com_localidade(df_socio, include_geral = include_geral) %>%
      filter(!is.na(.data[[col_dep]]), .data[[col_dep]] != "") %>%
      mutate(dep_num = suppressWarnings(as.numeric(.data[[col_dep]]))) %>%
      filter(!is.na(dep_num)) %>%
      mutate(
        categoria = case_when(
          dep_num == 0 ~ "0",
          dep_num == 1 ~ "1",
          dep_num == 2 ~ "2",
          dep_num == 3 ~ "3",
          dep_num == 4 ~ "4",
          dep_num == 5 ~ "5",
          dep_num >= 6 ~ ">=6",
          TRUE ~ NA_character_
        )
      ) %>%
      filter(!is.na(categoria))
    
    tab_dep <- base_dep %>%
      group_by(Localidade, categoria) %>%
      summarise(valor = dplyr::n_distinct(Nome.Completo), .groups = "drop")
    
    salvar_tabela_percentual(
      tab_dep,
      "04_tabela_numero_de_dependentes.xlsx",
      coluna_categoria = "categoria",
      coluna_valor = "valor",
      nome_categoria_saida = "Numero_de_dependentes"
    )
    
    ordem_dep <- c("0", "1", "2", "3", "4", "5", ">=6")
    pal_dep <- stats::setNames(paleta_categorica_10[1:7], ordem_dep)
    tab_dep$categoria <- factor(tab_dep$categoria, levels = ordem_dep)
    
    n_dep_fun <- function(local, incl) {
      base <- if (local == "Geral" && incl) df_socio else df_socio %>% filter(Zona.de.Pesca == local)
      base %>%
        filter(!is.na(.data[[col_dep]]), .data[[col_dep]] != "") %>%
        mutate(dep_num = suppressWarnings(as.numeric(.data[[col_dep]]))) %>%
        filter(!is.na(dep_num)) %>%
        summarise(n = dplyr::n_distinct(Nome.Completo)) %>%
        pull(n)
    }
    
    n_geral <- if (include_geral) n_dep_fun("Geral", TRUE) else NULL
    n_fluvial <- if (include_geral) n_dep_fun("Fluvial", TRUE) else NULL
    n_transicao <- if (include_geral) n_dep_fun("Transição", TRUE) else NULL
    n_lacustre <- if (include_geral) n_dep_fun("Lacustre", TRUE) else NULL
    n_montante <- if (!include_geral) n_dep_fun("Montante", FALSE) else NULL
    
    if (include_geral) {
      painel_pizza_3zonas_n(
        tab_dep,
        titulo_painel = "Número de dependentes",
        nome_arquivo = "04_numero_de_dependentes.png",
        paleta = pal_dep,
        nome_legenda = "Número de dependentes",
        n_geral = n_geral,
        n_fluvial = n_fluvial,
        n_transicao = n_transicao,
        n_lacustre = n_lacustre,
        texto_n = "Número total de registros de pescadores"
      )
    } else {
      painel_pizza_montante_n(
        tab_dep,
        titulo_painel = "Número de dependentes",
        nome_arquivo = "04_numero_de_dependentes.png",
        paleta = pal_dep,
        nome_legenda = "Número de dependentes",
        n_montante = n_montante,
        texto_n = "Número total de registros de pescadores"
      )
    }
  }
  
  # 05 Classes de ajudantes
  col_quem_aj <- "Quem.é.são.os.ajudantes"
  if (col_quem_aj %in% names(df_socio)) {
    tab_quem_aj <- preparar_tab_multiresposta(
      df_socio,
      col_quem_aj,
      include_geral = include_geral,
      keep_top_n = 5
    )
    
    salvar_tabela_percentual(
      tab_quem_aj,
      "05_tabela_classes_de_ajudantes.xlsx",
      coluna_categoria = "categoria",
      coluna_valor = "valor",
      nome_categoria_saida = "Classe_de_ajudante"
    )
    
    categorias_aj <- sort(unique(as.character(tab_quem_aj$categoria)))
    pal_aj <- paleta_alfabetica(categorias_aj)
    
    n_geral <- if (include_geral) n_valido_multiresposta(df_socio, col_quem_aj, "Geral", TRUE) else NULL
    n_fluvial <- if (include_geral) n_valido_multiresposta(df_socio, col_quem_aj, "Fluvial", TRUE) else NULL
    n_transicao <- if (include_geral) n_valido_multiresposta(df_socio, col_quem_aj, "Transição", TRUE) else NULL
    n_lacustre <- if (include_geral) n_valido_multiresposta(df_socio, col_quem_aj, "Lacustre", TRUE) else NULL
    n_montante <- if (!include_geral) n_valido_multiresposta(df_socio, col_quem_aj, "Montante", FALSE) else NULL
    
    if (include_geral) {
      painel_pizza_3zonas_n(
        tab_quem_aj,
        titulo_painel = "Classes de ajudantes",
        nome_arquivo = "05_classes_de_ajudantes.png",
        paleta = pal_aj,
        nome_legenda = "Ajudantes",
        n_geral = n_geral,
        n_fluvial = n_fluvial,
