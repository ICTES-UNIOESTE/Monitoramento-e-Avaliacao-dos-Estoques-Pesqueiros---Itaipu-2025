salvar_tabela_percentual <- function(tab, nome_arquivo,
                                     coluna_categoria = "categoria",
                                     coluna_valor = "valor",
                                     nome_categoria_saida = "Classe",
                                     multiplicar_100 = TRUE) {
  
  tab_out <- tab %>%
    ungroup() %>%
    mutate(
      !!coluna_categoria := as.character(.data[[coluna_categoria]])
    ) %>%
    group_by(Localidade) %>%
    mutate(
      Total_localidade = sum(.data[[coluna_valor]], na.rm = TRUE),
      Percentual = ifelse(Total_localidade > 0,
                          .data[[coluna_valor]] / Total_localidade,
                          0)
    ) %>%
    ungroup()
  
  if (multiplicar_100) {
    tab_out <- tab_out %>%
      mutate(Percentual = round(100 * Percentual, 2))
  } else {
    tab_out <- tab_out %>%
      mutate(Percentual = round(Percentual, 4))
  }
  
  names(tab_out)[names(tab_out) == coluna_categoria] <- nome_categoria_saida
  names(tab_out)[names(tab_out) == coluna_valor] <- "Valor"
  
  write.xlsx(tab_out, nome_arquivo, rowNames = FALSE)
}

salvar_tabela_percentual_generica <- function(tab, nome_arquivo,
                                              coluna_categoria,
                                              coluna_valor,
                                              nome_categoria_saida = "Classe",
                                              multiplicar_100 = TRUE) {
  salvar_tabela_percentual(
    tab = tab,
    nome_arquivo = nome_arquivo,
    coluna_categoria = coluna_categoria,
    coluna_valor = coluna_valor,
    nome_categoria_saida = nome_categoria_saida,
    multiplicar_100 = multiplicar_100
  )
}

