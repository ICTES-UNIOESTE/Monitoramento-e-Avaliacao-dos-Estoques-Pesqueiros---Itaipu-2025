salvar_tabela_percentual <- function(tab, nome_arquivo) {
  tab_out <- tab %>%
    group_by(Localidade) %>%
    mutate(
      Total_localidade = sum(valor, na.rm = TRUE),
      Percentual = round(100 * valor / Total_localidade, 2)
    ) %>%
    ungroup() %>%
    rename(
      Outra_fonte_de_renda = categoria,
      Valor = valor
    )
  
  write.xlsx(tab_out, nome_arquivo, rowNames = FALSE)
}

fazer_plot_pizza <- function(tab_local, paleta, titulo_local = NULL,
                             subtitulo_local = NULL,
                             mostrar_localidade = TRUE,
                             nome_legenda = "Atividades") {
  
  tab_local <- tab_local %>%
    mutate(categoria = factor(categoria, levels = names(paleta))) %>%
    complete(categoria, fill = list(valor = 0))
  
  ggplot(tab_local, aes(x = "", y = valor, fill = categoria)) +
    geom_col(color = "black", linewidth = 0.05, width = 1) +
    coord_polar("y", start = 0) +
    scale_fill_manual(values = paleta, drop = FALSE, name = nome_legenda) +
    labs(
      title = if (mostrar_localidade) titulo_local else NULL,
      subtitle = subtitulo_local
    ) +
    tema_pizza
}

design_2x2 <- "
AC
BD
"

criar_painel_2x2 <- function(plot_geral, plot_fluvial, plot_transicao, plot_lacustre,
                             titulo_painel) {
  
  painel <- (plot_geral + plot_transicao + plot_fluvial + plot_lacustre) +
    plot_layout(
      guides = "collect",
      design = design_2x2,
      widths = c(1, 1),
      heights = c(1, 1)
    ) &
    theme(
      legend.position = "right",
      legend.justification = "bottom",
      legend.box.just = "right",
      legend.direction = "vertical",
      plot.margin = margin(8, 8, 8, 8)
    )
  
  painel +
    plot_annotation(
      title = titulo_painel,
      theme = theme(
        plot.title = element_text(hjust = 0, size = 30, face = "bold"),
        plot.margin = margin(10, 10, 10, 10)
      )
    )
}

criar_figura_unica_montante <- function(plot_obj, titulo_painel) {
  plot_obj +
