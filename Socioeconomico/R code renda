subtitulo_n <- function(n, texto_base = "N") {
  paste0(texto_base, " = ", format(n, big.mark = ".", decimal.mark = ","))
}

paleta_por_ordem <- function(ordem_categorias) {
  cores <- rep(paleta_categorica_10, length.out = length(ordem_categorias))
  stats::setNames(cores, ordem_categorias)
}

extrair_bloco <- function(dados, col_categoria, col_valor, localidade) {
  dados %>%
    slice(-1) %>%
    transmute(
      Localidade = localidade,
      categoria = str_trim(as.character(.data[[names(dados)[col_categoria]]])),
      valor = suppressWarnings(as.numeric(.data[[names(dados)[col_valor]]]))
    ) %>%
    filter(
      !is.na(categoria),
      categoria != "",
      !is.na(valor),
      categoria != "Total Geral"
    ) %>%
    group_by(Localidade, categoria) %>%
    summarise(valor = sum(valor, na.rm = TRUE), .groups = "drop")
}

