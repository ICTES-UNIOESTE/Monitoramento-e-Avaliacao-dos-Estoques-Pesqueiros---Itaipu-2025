      TabParametros[i, 12] <- (length(count_adult) / length(maturidade2)) * 100
      TabParametros[i, 16] <- sum(maturidade2 == "IMT", na.rm = TRUE)
      TabParametros[i, 17] <- sum(maturidade2 != "IMT", na.rm = TRUE)
    }
    
    if(length(y) > 20){
      WT_LT <- lm(log10(y) ~ log10(x))
      TabParametros[i, 5] <- round(10^WT_LT$coefficients[1], 4)
      TabParametros[i, 6] <- round(WT_LT$coefficients[2], 4)
      parametros <- cbind(coef(WT_LT), confint(WT_LT))
      TabParametros[i, 7] <- parametros[2,2]
      TabParametros[i, 8] <- parametros[2,3]
    }
    
  }, error = function(e) {
    cat("Erro na espécie:", Comp[i], "\n")
    TabParametros[i, ] <- NA
  })
}

TabParametros[!is.finite(TabParametros)] <- NA
TabParametros <- as.data.frame(TabParametros)

