# 4) Riqueza e Diversidade (Shannon, Riqueza, Pielou J) - Montante
#    (mesmo conceito do seu script, só que sem zonas)
# ============================================================
Shannon <- rep(NA, length(levels(BioAnual25$Mes)))
Riqueza <- rep(NA, length(levels(BioAnual25$Mes)))

for (i in seq_along(levels(BioAnual25$Mes))) {
  Dados <- BioAnual25[BioAnual25$Mes == levels(BioAnual25$Mes)[i], ]
  
  # abundância por espécie no mês
  nSpp_mes <- tapply(Dados$N, Dados$Espécie, sum, default = 0)
  nSpp_mes <- nSpp_mes[!is.na(nSpp_mes)]
  
  # esforço no mês
  n_pesc <- nPescadorMes$N_pescadores[nPescadorMes$Mes == levels(BioAnual25$Mes)[i]]
  if (length(n_pesc) == 0 || is.na(n_pesc) || n_pesc == 0) next
  
  # CPUE por espécie no mês
  cpue_spp <- nSpp_mes / n_pesc
  
  Shannon[i] <- diversity(cpue_spp, index = "shannon")
  Riqueza[i] <- specnumber(cpue_spp)
}

J <- Shannon / log(Riqueza)

